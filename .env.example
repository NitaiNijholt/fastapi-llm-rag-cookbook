# Local run (default): leave CHROMA_HOST unset or empty.
# Data is stored in ./chroma_db/ — no Docker needed.
# CHROMA_HOST=
# CHROMA_PORT=8000

# Docker Compose sets these inside the api container automatically:
# CHROMA_HOST=chroma
# CHROMA_PORT=8000

# Generation (local CPU instruct model)
# GENERATION_MODEL=HuggingFaceTB/SmolLM2-360M-Instruct
# MAX_NEW_TOKENS=128
# GENERATION_TEMPERATURE=0.3
# REPETITION_PENALTY=1.1
